# ============================================================
# Indonesia Economic Intelligence — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- AI Provider (OpenAI-compatible) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- BPS Open API ---
# Register at: https://webapi.bps.go.id/
BPS_API_KEY=your_bps_api_key_here

# --- Bank Indonesia API (if available) ---
BI_API_KEY=your_bi_api_key_here

# --- Application Settings ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# --- Data Cache ---
# Seconds before cached data is refreshed from upstream
DATA_CACHE_TTL=3600

# --- CORS ---
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
